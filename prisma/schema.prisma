generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENTE
  ADMIN
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  role         Role     @default(CLIENTE)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  favoritos  Favorito[]
  avaliacoes Avaliacao[]
  carrinhos  Carrinho[]
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  produtos Produto[]
  criadoEm DateTime  @default(now())
}

model Produto {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Decimal  @db.Decimal(10, 2)
  disponivel   Boolean  @default(true)
  categoriaId  Int
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  categoria Categoria          @relation(fields: [categoriaId], references: [id])
  variacoes ProdutoVariacao[]
  imagens   ProdutoImagem[]
  favoritos Favorito[]
  avaliacoes Avaliacao[]
}

model Cor {
  id        Int               @id @default(autoincrement())
  nome      String            @unique
  hex       String?
  variacoes ProdutoVariacao[]
  imagens   ProdutoImagem[]
}

model Tamanho {
  id        Int               @id @default(autoincrement())
  nome      String            @unique
  variacoes ProdutoVariacao[]
}

model ProdutoVariacao {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  corId      Int?
  tamanhoId  Int
  disponivel Boolean  @default(true)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cor     Cor?    @relation(fields: [corId], references: [id])
  tamanho Tamanho @relation(fields: [tamanhoId], references: [id])

  itensCarrinho ItemCarrinho[]

  @@unique([produtoId, corId, tamanhoId])
}

model ProdutoImagem {
  id         Int    @id @default(autoincrement())
  imagemUrl  String
  produtoId  Int
  corId      Int?

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cor     Cor?    @relation(fields: [corId], references: [id])

  criadoEm DateTime @default(now())
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  produtoId Int
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Avaliacao {
  id         Int      @id @default(autoincrement())
  nota       Int
  comentario String?
  usuarioId  Int
  produtoId  Int
  criadoEm   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Carrinho {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  finalizado   Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens   ItemCarrinho[]
}

model ItemCarrinho {
  id                 Int @id @default(autoincrement())
  carrinhoId         Int
  produtoVariacaoId  Int
  quantidade         Int @default(1)

  carrinho         Carrinho        @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produtoVariacao  ProdutoVariacao @relation(fields: [produtoVariacaoId], references: [id])

  @@unique([carrinhoId, produtoVariacaoId])
}